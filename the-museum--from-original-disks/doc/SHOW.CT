/*  FILE = show.c */

/* This file contains display procedures to be used during debugging and
 * normal operation to display various pieces of data.
 */

#ifdef MSDOS
#include <stdlib.h>
#endif

#include <stdio.h>

/* Type declarations follow.
 */

#include "net_type.h"

/* To use external routines and variables:
 */

#include "error.h"
#include "fishNET.h"

/* Displays the whole network on stdout.
 */

void
show_network(network, parameter)
LAYER           *network;
QUESTION        *parameter;
{
 	LAYER   *present_net;
 	NEURON  *neuron;
 	WEIGHT  *weight;

 	int     i;
 	int	j;
 	int	k;

 	FILE    *PORT;

 	PORT = stdout;

 	for
 	(
 		i = 0, present_net = network;
 		i < parameter->layers;
 		i++, present_net++
 	){

 		fprintf(PORT, "Layer = %d.\n", i);

 		for
 		(
 			j = 0, neuron = present_net->layer;
 			j < parameter->per_layer[i];
 			j++, neuron++
 		){

 			fprintf(PORT, "\t n %d, out = %lf.\n", j, neuron->y);

 			for
 			(
 				k = 0, weight = neuron->weight;
 				k < parameter->per_layer[i+1];
 				k++, weight++
 			)

 				fprintf
 				(
 					PORT,
 					"\t\t%d, %lf, %lf, %lf.\n",
 					k, weight->w, weight->dE_dw,
 						weight->old_delta_w
 				);

 		fprintf(PORT, "\n");
 		}
 	}
}

/* Prints the whole network on stdprn.
 */

void
print_network(network, parameter)
LAYER           *network;
QUESTION        *parameter;
{
 	LAYER   *present_net;
 	NEURON  *neuron;
 	WEIGHT  *weight;

 	int     i;
 	int	j;
 	int	k;

 	FILE    *PORT;

 	PORT = stdprn;

 	for
 	(
 		i = 0, present_net = network;
 		i < parameter->layers;
 		i++, present_net++
 	){

 		fprintf(PORT, "Layer = %d.\n", i);

 		for
 		(
 			j = 0, neuron = present_net->layer;
 			j < parameter->per_layer[i];
 			j++, neuron++
 		){

 			fprintf(PORT, "\t n %d, out = %lf.\n", j, neuron->y);

 			for
 			(
 				k = 0, weight = neuron->weight;
 				k < parameter->per_layer[i+1];
 				k++, weight++
 			){
 				fprintf
 				(
 					PORT,
 					"\t\t%d, %lf, %lf, %lf.\n",
 					k, weight->w, weight->dE_dw,
 					weight->old_delta_w
 				);
 			}
 		fprintf(PORT, "\n");
 		}
 	}
}

/* This routine displays all the data from the file relating to file_data.
 */

void
show_data(data, file_data)
I_O             *data;
DATA_FILE       file_data;
{
 	int     i;
 	int	j;

 	I_O     *work;
 	OP_DATA *xptr;

 	FILE    *PORT;

 	PORT = stdout;

 	for
 	(
 		i = 0, work = data;
 		i < file_data.i_o_cases;
 		i++, work++
 	){

 		fprintf(PORT, "Case = %d.\n\t", i);

 		for
 		(
 			j = 0, xptr = work->item;
 			j < file_data.neurons;
 			j++, xptr++
 		)

 			fprintf(PORT, " %lf", xptr->x);

 		fprintf ( PORT, "\n" );
 	}
}

/* This routine prints all the data from the file relating to file_data.
 */

void
print_data(data, file_data)
I_O             *data;
DATA_FILE       file_data;
{
 	int     i;
 	int	j;

 	I_O     *work;
 	OP_DATA *xptr;

 	FILE    *PORT;

 	PORT = stdprn;

 	for
 	(
 		i = 0, work = data;
 		i < file_data.i_o_cases;
 		i++, work++
 	){

 		fprintf(PORT, "Case = %d.\n\t", i);

 		for
 		(
 			j = 0, xptr = work->item;
 			j < file_data.neurons;
 			j++, xptr++
 		)

 			fprintf(PORT, " %lf", xptr->x);

 		fprintf(PORT, "\n");
 	}
}

/* Displays the required i/o case on stdout.
 */

void
show_case(data, neurons, width)
OP_DATA *data;
int     neurons;
int	width;
{

 	int     i;
 	OP_DATA *work;

 	FILE    *PORT;

 	PORT = stdout;

 	fprintf(PORT, "Data =\t");

 	for (i = 0, work = data; i < neurons; i++, work++)
 	{
 		fprintf(PORT, "%lf ", work->x);
 		if ( (i + 1) % width == 0 )
 			fprintf(PORT, "\n\t");
 	}

}

/* Prints the required i/o case on stdprn.
 */

void
print_case(data, neurons)
OP_DATA *data;
int     neurons;
{

 	int     i;
 	OP_DATA *work;

 	FILE    *PORT;

 	PORT = stdprn;

 	fprintf(PORT, "Data =\t");

 	for (i = 0, work = data; i < neurons; i++, work++)
 	{
 		fprintf(PORT, "%lf ", work->x);
 		if ( (i+1) % 10 == 0 )
 			fprintf(PORT, "\n\t");
 	}
}

/* Displays the top (output) layer of neurons' output.
 */

void
show_top_layer(network, parameter)
LAYER           *network;
QUESTION        *parameter;
{

 	NEURON  *neuron;
 	int     i;

 	FILE    *PORT;

 	PORT = stdout;

 	fprintf(PORT, "\nOutput =");

 	for
 	(
 		i = 0, neuron = (network + parameter->layers - 1)->layer;
 		i < parameter->per_layer[parameter->layers - 1];
 		i++, neuron++
 	){
 		fprintf(PORT, "%lf ", neuron->y);
 		if ( (i+1) % parameter->out_width == 0 )
 			fprintf(PORT, "\n\t");
 	}
}

/* Prints the top (output) layer of neurons' output.
 */

void
print_top_layer(network, parameter)
LAYER           *network;
QUESTION        *parameter;
{
 	NEURON  *neuron;
 	int     i;

 	FILE    *PORT;

